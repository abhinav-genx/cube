{
  "name": "cube",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "eas-build-pre-install": "node scripts/check-release.js",
    "check-release": "CUBE_RELEASE=1 node scripts/check-release.js",
    "postinstall": "npx --yes patch-package@8"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "expo": "^58.0.23",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-screen-capture": "~58.0.6",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "fflate": "0.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keychain": "^11.0.0",
    "react-native-libsodium": "^1.7.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
